+static void nvfwd_get_timeslice(Object *obj, Visitor *v, const char *name,
+                                 void *opaque, Error **errp)
+{
+    NvfwdState *s = NVFWD(obj);
+    uint64_t us;
+    if (!nvfwd_budget_ready(obj, errp)) {
+        return;
+    }
+    timeslice_enter(&s->timeslice);
+    us = s->timeslice.desired_us;
+    timeslice_leave(&s->timeslice);
+    visit_type_uint64(v, name, &us, errp);
+}
+
+static void nvfwd_set_timeslice(Object *obj, Visitor *v, const char *name,
+                                 void *opaque, Error **errp)
+{
+    NvfwdState *s = NVFWD(obj);
+    int64_t us;
+    uint32_t failed;
+    if (!nvfwd_budget_ready(obj, errp) || !visit_type_int64(v, name, &us, errp)) {
+        return;
+    }
+    if (s->no_gpu || us <= 0) {
+        error_setg(errp, "timeslice-us requires a GPU and a value in 1..INT64_MAX");
+        return;
+    }
+    failed = timeslice_set(&s->timeslice, us, host_timeslice_apply, s);
+    if (failed) {
+        error_setg(errp, "timeslice policy retained; %u TSG references failed; read timeslice-status",
+                   failed);
+    }
+}
+
+static void nvfwd_get_timeslice_status(Object *obj, Visitor *v, const char *name,
+                                       void *opaque, Error **errp)
+{
+    NvfwdState *s = NVFWD(obj);
+    char *text;
+    if (!nvfwd_budget_ready(obj, errp)) {
+        return;
+    }
+    text = timeslice_report(&s->timeslice);
+    visit_type_str(v, name, &text, errp);
+    g_free(text);
+}
+
