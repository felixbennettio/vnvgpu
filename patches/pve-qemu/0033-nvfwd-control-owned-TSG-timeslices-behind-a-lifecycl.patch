     int closing = -1;
 
@@ -43,10 +43,18 @@ void fd_release(NvfwdState *s, uint32_t id)
     }
 }
 
+void fd_release(NvfwdState *s, uint32_t id)
+{
+    timeslice_enter(&s->timeslice);
+    fd_release_locked(s, id);
+    timeslice_leave(&s->timeslice);
+}
+
 void fd_close(NvfwdState *s, uint32_t id)
 {
     int fd;
 
+    timeslice_enter(&s->timeslice);
     qemu_mutex_lock(&s->lock);
     fd = s->fds[id];
