diff --git a/hw/misc/nvfwd/timeslice.c b/hw/misc/nvfwd/timeslice.c
new file mode 100644
index 0000000..ed3fec2
--- /dev/null
+++ b/hw/misc/nvfwd/timeslice.c
@@ -0,0 +1,185 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Owned TSG references, real control outcomes, and the narrow lifecycle gate.
+ * This is requested policy, not hardware readback or a fairness guarantee. */
+#include "timeslice.h"
+#include "rm_layout.h"
+#include <errno.h>
+#include <string.h>
+#include <sys/ioctl.h>
+
+static uint32_t u32(const uint8_t *p)
+{
+    uint32_t v;
+    memcpy(&v, p, sizeof(v));
+    return v;
+}
+
+void timeslice_init(Timeslice *t, Objects *objects)
+{
+    g_mutex_init(&t->lifecycle);
+    t->objects = objects;
+    t->desired_us = 0;
+}
+
+void timeslice_enter(Timeslice *t) { g_mutex_lock(&t->lifecycle); }
+void timeslice_leave(Timeslice *t) { g_mutex_unlock(&t->lifecycle); }
+
+bool timeslice_gated_call(uint32_t nr, const uint8_t *arg, uint32_t size)
+{
+    switch (nr) {
+    case ESC_RM_ALLOC:
+    case ESC_RM_ALLOC_MEMORY:
+    case ESC_RM_DUP_OBJECT:
+    case ESC_RM_ALLOC_CONTEXT_DMA2:
+    case ESC_RM_VID_HEAP_CONTROL:
+    case ESC_RM_FREE:
+        return true;
+    case ESC_RM_CONTROL:
+        return size >= RM_CONTROL_BYTES &&
+               (u32(arg + RM_CONTROL_CMD) == TSG_SCHEDULE ||
+                u32(arg + RM_CONTROL_CMD) == TSG_SET_TIMESLICE);
+    default:
+        return false;
+    }
+}
+
+static void apply_one(Timeslice *t, const ObjectInfo *info,
+                      TimesliceApply *apply, void *opaque)
+{
+    TimesliceResult r = { .error = ESTALE };
+    ObjectInfo now;
+    if (info->tsg_owned &&
+        objects_get(t->objects, info->client, info->object, &now) &&
+        now.generation == info->generation && now.tsg_owned) {
+        r = apply(opaque, &now, t->desired_us);
+    }
+    objects_timeslice_result(t->objects, info, t->desired_us, r.error, r.status);
+}
+
+void timeslice_created(Timeslice *t, uint32_t client, uint32_t object,
+                       TimesliceApply *apply, void *opaque)
+{
+    ObjectInfo info;
+    if (t->desired_us && objects_get(t->objects, client, object, &info) &&
+        (info.hclass == TSG_CLASS || info.hclass == TSG_UNKNOWN_CLASS)) {
+        /* ALLOC alone is not proof of schedulability. Keep the real failure;
+         * a later successful SCHEDULE retries before returning to the guest. */
+        apply_one(t, &info, apply, opaque);
+    }
+}
+
+uint32_t timeslice_guest_before(Timeslice *t, const uint8_t *arg, uint32_t size)
+{
+    ObjectInfo info;
+    uint64_t pointer, us;
+    if (size != RM_CONTROL_BYTES ||
+        u32(arg + RM_CONTROL_CMD) != TSG_SET_TIMESLICE || !t->desired_us) {
+        return STATUS_OK;
+    }
+    memcpy(&pointer, arg + RM_CONTROL_PARAMS, sizeof(pointer));
+    /* Called only after rmargs/apply_fields validated and rewrote this pointer. */
+    if (!pointer || u32(arg + RM_CONTROL_PARAMS_SIZE) != sizeof(us)) {
+        return STATUS_INVALID_ARGUMENT;
+    }
+    if (!objects_get(t->objects, u32(arg), u32(arg + RM_CONTROL_OBJECT), &info) ||
+        !info.tsg_owned) {
+        return STATUS_OK; /* do not invent ownership; RM still validates this call */
+    }
+    memcpy(&us, (const void *)(uintptr_t)pointer, sizeof(us));
+    return us == t->desired_us ? STATUS_OK : STATUS_INSUFFICIENT_PERMISSIONS;
+}
+
+void timeslice_guest_after(Timeslice *t, const uint8_t *arg, uint32_t size, int ret,
+                           TimesliceApply *apply, void *opaque)
+{
+    uint64_t pointer;
+    uint32_t cmd;
+    ObjectInfo info;
+    if (size != RM_CONTROL_BYTES) {
+        return;
+    }
+    cmd = u32(arg + RM_CONTROL_CMD);
+    if ((cmd != TSG_SCHEDULE && cmd != TSG_SET_TIMESLICE) || !t->desired_us) {
+        return; /* other controls do not hold lifecycle */
+    }
+    memcpy(&pointer, arg + RM_CONTROL_PARAMS, sizeof(pointer));
+    if (cmd == TSG_SET_TIMESLICE) {
+        /* A matching guest SET also has a real result. Conflicting requests
+         * were rejected before ioctl and never arrive here. */
+        if (objects_get(t->objects, u32(arg), u32(arg + RM_CONTROL_OBJECT), &info) &&
+            info.tsg_owned) {
+            objects_timeslice_result(t->objects, &info, t->desired_us,
+                                     ret < 0 ? -ret : 0,
+                                     ret < 0 ? 0 : u32(arg + RM_CONTROL_STATUS));
+        }
+        return;
+    }
+    if (ret >= 0 && u32(arg + RM_CONTROL_STATUS) == STATUS_OK && pointer &&
+        u32(arg + RM_CONTROL_PARAMS_SIZE) == 3 &&
+        *(const uint8_t *)(uintptr_t)pointer == 1) {
+        timeslice_created(t, u32(arg), u32(arg + RM_CONTROL_OBJECT), apply, opaque);
+    }
+}
+
+uint32_t timeslice_set(Timeslice *t, uint64_t us, TimesliceApply *apply, void *opaque)
+{
+    uint32_t count, failed = 0;
+    ObjectInfo *refs;
+    g_assert(us != 0);
+    timeslice_enter(t);
+    t->desired_us = us;
+    refs = objects_tsg_refs(t->objects, &count);
+    for (uint32_t i = 0; i < count; i++) {
+        ObjectInfo now;
+        apply_one(t, &refs[i], apply, opaque);
+        if (!objects_get(t->objects, refs[i].client, refs[i].object, &now) ||
+            now.generation != refs[i].generation || now.timeslice_errno ||
+            now.timeslice_status || now.timeslice_us != us) {
+            failed++;
+        }
+    }
+    g_free(refs);
+    timeslice_leave(t);
+    return failed;
+}
+
+char *timeslice_report(Timeslice *t)
+{
+    uint32_t count;
+    ObjectInfo *refs;
+    GString *s = g_string_new(NULL);
+    timeslice_enter(t);
+    refs = objects_tsg_refs(t->objects, &count);
+    g_string_append_printf(s, "version=1 requested_us=%" G_GUINT64_FORMAT
+                           " scope=requested-not-hardware references=%u\n", t->desired_us, count);
+    for (uint32_t i = 0; i < count; i++) {
+        ObjectInfo *r = &refs[i];
+        g_string_append_printf(s, "client=%#x object=%#x generation=%" G_GUINT64_FORMAT
+            " owned=%u attempted=%u requested_us=%" G_GUINT64_FORMAT
+            " errno=%d rm_status=%#x\n", r->client, r->object, r->generation,
+            r->tsg_owned, r->timeslice_attempted, r->timeslice_us,
+            r->timeslice_errno, r->timeslice_status);
+    }
+    g_free(refs);
+    timeslice_leave(t);
+    return g_string_free(s, FALSE);
+}
+
+TimesliceResult timeslice_ioctl(int fd, const ObjectInfo *info, uint64_t us)
+{
+    /* NVOS54_PARAMETERS, 615 nvos.h. The ioctl encodes its exact 32-byte size. */
+    struct {
+        uint32_t client, object, command, flags;
+        uint64_t params;
+        uint32_t params_size, status;
+    } control = { .client = info->client, .object = info->object,
+                  .command = TSG_SET_TIMESLICE, .params = (uintptr_t)&us,
+                  .params_size = sizeof(us) };
+    int rc;
+    _Static_assert(sizeof(control) == RM_CONTROL_BYTES, "NVOS54 layout");
+    do {
+        rc = ioctl(fd, _IOWR('F', ESC_RM_CONTROL, control), &control);
+    } while (rc < 0 && errno == EINTR);
+    return (TimesliceResult) { .error = rc < 0 ? errno : 0,
+                              .status = rc < 0 ? 0 : control.status };
+}
