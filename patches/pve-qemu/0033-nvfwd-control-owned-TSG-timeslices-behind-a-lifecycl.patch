+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef NVFWD_TIMESLICE_H
+#define NVFWD_TIMESLICE_H
+#include <glib.h>
+#include "objects.h"
+
+#define TSG_CLASS 0xa06cu
+#define TSG_SCHEDULE 0xa06c0101u
+#define TSG_SET_TIMESLICE 0xa06c0103u
+#define TSG_UNKNOWN_CLASS UINT32_MAX
+
+typedef struct Timeslice {
+    /* Always active, including before policy is enabled. Lock order:
+     * lifecycle, NvfwdState.lock, Objects.lock. Never reverse it. */
+    GMutex lifecycle;
+    Objects *objects;
+    uint64_t desired_us;
+} Timeslice;
+
+typedef struct TimesliceResult { int error; uint32_t status; } TimesliceResult;
+typedef TimesliceResult TimesliceApply(void *opaque, const ObjectInfo *info, uint64_t us);
+void timeslice_init(Timeslice *t, Objects *objects);
+void timeslice_enter(Timeslice *t);
+void timeslice_leave(Timeslice *t);
+bool timeslice_gated_call(uint32_t nr, const uint8_t *arg, uint32_t size);
+/* Locked helpers: caller holds lifecycle through the actual guest ioctl and accounting. */
+void timeslice_created(Timeslice *t, uint32_t client, uint32_t object,
+                       TimesliceApply *apply, void *opaque);
+uint32_t timeslice_guest_before(Timeslice *t, const uint8_t *arg, uint32_t size);
+void timeslice_guest_after(Timeslice *t, const uint8_t *arg, uint32_t size, int ret,
+                           TimesliceApply *apply, void *opaque);
+/* Desired policy persists on partial failure. Returns the number of failed references. */
+uint32_t timeslice_set(Timeslice *t, uint64_t us, TimesliceApply *apply, void *opaque);
+char *timeslice_report(Timeslice *t);
+TimesliceResult timeslice_ioctl(int fd, const ObjectInfo *info, uint64_t us);
+#endif
