@@ -499,13 +513,34 @@ static void forward_ioctl(NvfwdState *s, Bounce *b, uint32_t *held, uint32_t *nh
 void do_ioctl(NvfwdState *s, Bounce *b)
 {
     uint32_t held[NVFWD_MAX_FIX], nheld = 0;
+    RmCall parsed = { 0 };
+    bool gated = false;
 
+    /* Parse the private bounce buffer before selecting the lifecycle gate.
+     * Validation is repeated inside it; malformed calls never reach RM. */
+    if (host_fd(s, b->req.fdid) >= 0 &&
+        s->fd_kind[b->req.fdid] != NVFWD_DEV_UVM &&
+        rmargs_parse(&parsed, b->req.cmd, b->data, b->req.len,
+                     b->req.fix, b->req.nfix)) {
+        gated = timeslice_gated_call(parsed.nr, b->data + parsed.arg_at, parsed.size);
+    }
+    if (gated) {
+        timeslice_enter(&s->timeslice);
+    }
     if (host_fd(s, b->req.fdid) < 0) {
         b->req.ret = -EBADF;
-        return;
+        goto out;
     }
     forward_ioctl(s, b, held, &nheld);
     while (nheld) {
-        fd_release(s, held[--nheld]);
+        if (gated) {
+            fd_release_locked(s, held[--nheld]);
+        } else {
+            fd_release(s, held[--nheld]);
+        }
+    }
+out:
+    if (gated) {
+        timeslice_leave(&s->timeslice);
     }
 }
diff --git a/hw/misc/nvfwd/host_timeslice.c b/hw/misc/nvfwd/host_timeslice.c
new file mode 100644
index 0000000..d3e1f2a
--- /dev/null
+++ b/hw/misc/nvfwd/host_timeslice.c
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include "nvfwd.h"
+
+/* lifecycle is held. Its root fd owns the client and cannot be closed/reused
+ * until the ioctl and pin release have finished. No global GPU handle lookup. */
+TimesliceResult host_timeslice_apply(void *opaque, const ObjectInfo *info, uint64_t us)
+{
+    NvfwdState *s = opaque;
+    TimesliceResult result = { .error = EBADF };
+    if (fd_hold(s, info->root_file)) {
+        result = timeslice_ioctl(host_fd(s, info->root_file), info, us);
+        fd_release_locked(s, info->root_file);
+    }
+    return result;
+}
