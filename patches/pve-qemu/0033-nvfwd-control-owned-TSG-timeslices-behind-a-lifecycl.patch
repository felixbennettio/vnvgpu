 };
 
 static uint64_t key_of(uint32_t client, uint32_t object)
@@ -124,6 +125,12 @@ void objects_add(Objects *o, const ObjectClaim *claim, uint64_t bytes, const Obj
     e->bytes = bytes;
     e->key = key_of(info->client, info->object);
     g_mutex_lock(&o->lock);
+    /* Exhaustion fails closed: generation 0 can never be a control target. */
+    e->info.generation = o->generation == UINT64_MAX ? 0 : ++o->generation;
+    e->info.timeslice_attempted = false;
+    e->info.timeslice_us = 0;
+    e->info.timeslice_errno = 0;
+    e->info.timeslice_status = 0;
     drop_claim(o, claim);
     /* A handle used again means the driver dropped the old object without being asked here. */
     if (find(o, info->client, info->object)) {
@@ -243,3 +250,66 @@ uint64_t objects_reservation(Objects *o, MemoryKind kind)
     g_mutex_unlock(&o->lock);
     return bytes;
 }
+
+/* All ancestry is resolved under one Objects lock. We never infer class from a
+ * numeric handle or from another process's GPU channel list. */
+static void snapshot(Objects *o, Entry *e, ObjectInfo *info)
+{
+    Entry *root = find(o, e->info.client, e->info.client);
+    Entry *parent = find(o, e->info.client, e->info.parent);
+    *info = e->info;
+    info->root_file = root ? root->info.file : UINT32_MAX;
+    info->tsg_owned = info->generation && !info->local && info->hclass == 0xa06c &&
+        root && !root->info.local && root->info.parent == root->info.object &&
+        (root->info.hclass == 0 || root->info.hclass == 0x41) &&
+        parent && !parent->info.local && parent->info.hclass == 0x80;
+}
+
+bool objects_get(Objects *o, uint32_t client, uint32_t object, ObjectInfo *info)
+{
+    Entry *e;
+    g_mutex_lock(&o->lock);
+    e = find(o, client, object);
+    if (e) {
+        snapshot(o, e, info);
+    }
+    g_mutex_unlock(&o->lock);
+    return e != NULL;
+}
+
+ObjectInfo *objects_tsg_refs(Objects *o, uint32_t *count)
+{
+    GHashTableIter it;
+    Entry *e;
+    ObjectInfo *refs;
+    *count = 0;
+    g_mutex_lock(&o->lock);
+    refs = g_new(ObjectInfo, g_hash_table_size(o->entries));
+    g_hash_table_iter_init(&it, o->entries);
+    while (g_hash_table_iter_next(&it, NULL, (void **)&e)) {
+        if (!e->info.local && (e->info.hclass == 0xa06c ||
+                              e->info.hclass == UINT32_MAX)) {
+            snapshot(o, e, &refs[(*count)++]);
+        }
+    }
+    g_mutex_unlock(&o->lock);
+    return refs;
+}
+
+bool objects_timeslice_result(Objects *o, const ObjectInfo *ref, uint64_t us,
+                              int error, uint32_t status)
+{
+    Entry *e;
+    bool same;
+    g_mutex_lock(&o->lock);
+    e = find(o, ref->client, ref->object);
+    same = e && ref->generation && e->info.generation == ref->generation;
+    if (same) {
+        e->info.timeslice_attempted = ref->tsg_owned;
+        e->info.timeslice_us = us;
+        e->info.timeslice_errno = error;
+        e->info.timeslice_status = status;
+    }
+    g_mutex_unlock(&o->lock);
+    return same;
+}
