+++ b/hw/misc/nvfwd/host_timeslice.c
@@ -14,3 +14,15 @@ TimesliceResult host_timeslice_apply(void *opaque, const ObjectInfo *info, uint6
     }
     return result;
 }
+
+/* Same owned-root pin and lifecycle contract; no privileged helper. */
+TimesliceResult host_interleave_apply(void *opaque, const ObjectInfo *info, uint32_t level)
+{
+    NvfwdState *s = opaque;
+    TimesliceResult result = { .error = EBADF };
+    if (fd_hold(s, info->root_file)) {
+        result = interleave_ioctl(host_fd(s, info->root_file), info, level);
+        fd_release_locked(s, info->root_file);
+    }
+    return result;
+}
diff --git a/hw/misc/nvfwd/interleave.c b/hw/misc/nvfwd/interleave.c
new file mode 100644
index 0000000..3aed95b
--- /dev/null
+++ b/hw/misc/nvfwd/interleave.c
@@ -0,0 +1,167 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Host-only 615 interleave requests. No privilege escalation or fairness claim. */
+#include "interleave.h"
+#include "rm_layout.h"
+#include <errno.h>
+#include <string.h>
+#include <sys/ioctl.h>
+
+static uint32_t u32(const uint8_t *p)
+{
+    uint32_t value;
+    memcpy(&value, p, sizeof(value));
+    return value;
+}
+
+static void apply_one(Timeslice *t, const ObjectInfo *ref,
+                      InterleaveApply *apply, void *opaque)
+{
+    ObjectInfo now;
+    TimesliceResult result = { .error = ESTALE };
+    if (ref->tsg_owned &&
+        objects_get(t->objects, ref->client, ref->object, &now) &&
+        now.generation == ref->generation && now.tsg_owned) {
+        result = apply(opaque, &now, t->interleave_level);
+    }
+    objects_interleave_result(t->objects, ref, t->interleave_level,
+                              result.error, result.status);
+}
+
+void interleave_created(Timeslice *t, uint32_t client, uint32_t object,
+                        InterleaveApply *apply, void *opaque)
+{
+    ObjectInfo info;
+    if (t->interleave_configured &&
+        objects_get(t->objects, client, object, &info) &&
+        (info.hclass == TSG_CLASS || info.hclass == TSG_UNKNOWN_CLASS)) {
+        /* ALLOC alone is not readiness proof; preserve the actual failure. */
+        apply_one(t, &info, apply, opaque);
+    }
+}
+
+void interleave_guest_after(Timeslice *t, const uint8_t *arg, uint32_t size, int ret,
+                            InterleaveApply *apply, void *opaque)
+{
+    uint64_t pointer;
+    if (size != RM_CONTROL_BYTES || u32(arg + RM_CONTROL_CMD) != TSG_SCHEDULE) {
+        return; /* unrelated controls do not hold lifecycle */
+    }
+    if (!t->interleave_configured || ret < 0 ||
+        u32(arg + RM_CONTROL_STATUS) != STATUS_OK) {
+        return;
+    }
+    /* rmargs/apply_fields already validated and rewrote this pointer. */
+    memcpy(&pointer, arg + RM_CONTROL_PARAMS, sizeof(pointer));
+    if (pointer && u32(arg + RM_CONTROL_PARAMS_SIZE) == 3 &&
+        *(const uint8_t *)(uintptr_t)pointer == 1) {
+        interleave_created(t, u32(arg), u32(arg + RM_CONTROL_OBJECT), apply, opaque);
+    }
+}
+
+bool interleave_set(Timeslice *t, uint32_t level, InterleaveApply *apply,
+                    void *opaque, uint32_t *failed)
+{
+    ObjectInfo *refs;
+    uint32_t count;
+    *failed = 0;
+    if (level > 2) {
+        return false;
+    }
+    timeslice_enter(t);
+    t->interleave_configured = true; /* LOW=0 is a real request, never unset. */
+    t->interleave_level = level;
+    refs = objects_tsg_refs(t->objects, &count);
+    for (uint32_t i = 0; i < count; i++) {
+        ObjectInfo now;
+        apply_one(t, &refs[i], apply, opaque);
+        if (!objects_get(t->objects, refs[i].client, refs[i].object, &now) ||
+            now.generation != refs[i].generation || now.interleave_errno ||
+            now.interleave_status || !now.interleave_requested ||
+            now.interleave_level != level) {
+            (*failed)++;
+        }
+    }
+    g_free(refs);
+    timeslice_leave(t);
+    return true;
+}
+
+char *interleave_report(Timeslice *t)
+{
+    enum { MAX_REPORTED_REFS = 64, MAX_REPORT_BYTES = 16 * 1024 };
+    uint32_t count, reported = 0, accepted = 0, failed = 0, pending = 0;
+    ObjectInfo *refs;
+    GString *rows = g_string_new(NULL), *s;
+    char desired[16];
+    timeslice_enter(t);
+    refs = objects_tsg_refs(t->objects, &count);
+    if (t->interleave_configured) {
+        g_snprintf(desired, sizeof(desired), "%u", t->interleave_level);
+    } else {
+        g_strlcpy(desired, "unset", sizeof(desired));
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        ObjectInfo *r = &refs[i];
+        if (t->interleave_configured) {
+            if (!r->tsg_owned || r->interleave_errno || r->interleave_status) {
+                failed++;
+            } else if (!r->interleave_requested || !r->interleave_attempted ||
+                       r->interleave_level != t->interleave_level) {
+                pending++;
+            } else {
+                accepted++;
+            }
+        }
+        if (reported < MAX_REPORTED_REFS) {
+            char level[16];
+            if (r->interleave_requested) {
+                g_snprintf(level, sizeof(level), "%u", r->interleave_level);
+            } else {
+                g_strlcpy(level, "unset", sizeof(level));
+            }
+            char *row = g_strdup_printf("client=%#x object=%#x generation=%" G_GUINT64_FORMAT
+                " owned=%u attempted=%u requested_level=%s errno=%d rm_status=%#x\n",
+                r->client, r->object, r->generation, r->tsg_owned,
+                r->interleave_attempted, level, r->interleave_errno, r->interleave_status);
+            if (rows->len + strlen(row) <= MAX_REPORT_BYTES - 512) {
+                g_string_append(rows, row);
+                reported++;
+            }
+            g_free(row);
+        }
+    }
+    s = g_string_new(NULL);
+    g_string_append_printf(s, "version=1 requested_level=%s"
+        " scope=requested-not-hardware-or-fixed-weight references=%u reported=%u truncated=%u"
+        " accepted=%u failed=%u pending=%u\n",
+        desired, count, reported, reported < count, accepted, failed, pending);
+    g_string_append_len(s, rows->str, rows->len);
+    g_assert(s->len <= MAX_REPORT_BYTES);
+    g_string_free(rows, TRUE);
+    g_free(refs);
+    timeslice_leave(t);
+    return g_string_free(s, FALSE);
+}
+
+TimesliceResult interleave_ioctl(int fd, const ObjectInfo *info, uint32_t level)
+{
+    /* 615 NVOS54_PARAMETERS + NVA06C_CTRL_INTERLEAVE_LEVEL_PARAMS (u32).
+     * Requires RS_ACCESS_NICE/CAP_SYS_NICE; do not hide the actual denial. */
+    struct {
+        uint32_t client, object, command, flags;
+        uint64_t params;
+        uint32_t params_size, status;
+    } control = { .client = info->client, .object = info->object,
+                  .command = TSG_SET_INTERLEAVE, .params = (uintptr_t)&level,
+                  .params_size = sizeof(level) };
+    int rc;
+    if (level > 2) {
+        return (TimesliceResult) { .error = EINVAL };
+    }
+    _Static_assert(sizeof(control) == RM_CONTROL_BYTES, "NVOS54 layout");
+    do {
+        rc = ioctl(fd, _IOWR('F', ESC_RM_CONTROL, control), &control);
+    } while (rc < 0 && errno == EINTR);
+    return (TimesliceResult) { .error = rc < 0 ? errno : 0,
+                              .status = rc < 0 ? 0 : control.status };
+}
diff --git a/hw/misc/nvfwd/interleave.h b/hw/misc/nvfwd/interleave.h
new file mode 100644
index 0000000..80d14a9
--- /dev/null
+++ b/hw/misc/nvfwd/interleave.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef NVFWD_INTERLEAVE_H
+#define NVFWD_INTERLEAVE_H
+#include "timeslice.h"
+
+#define TSG_SET_INTERLEAVE 0xa06c0107u
+typedef TimesliceResult InterleaveApply(void *opaque, const ObjectInfo *info, uint32_t level);
+/* Caller holds the existing lifecycle gate for these guest-completion hooks. */
+void interleave_created(Timeslice *t, uint32_t client, uint32_t object,
+                        InterleaveApply *apply, void *opaque);
+void interleave_guest_after(Timeslice *t, const uint8_t *arg, uint32_t size, int ret,
+                            InterleaveApply *apply, void *opaque);
+/* False for invalid level without changing policy. On true, failed counts real
+ * failures/unowned references; desired remains configured even on partial failure. */
+bool interleave_set(Timeslice *t, uint32_t level, InterleaveApply *apply,
+                    void *opaque, uint32_t *failed);
+char *interleave_report(Timeslice *t);
+TimesliceResult interleave_ioctl(int fd, const ObjectInfo *info, uint32_t level);
+#endif
