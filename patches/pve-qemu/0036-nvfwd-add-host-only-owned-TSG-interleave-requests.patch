diff --git a/hw/misc/nvfwd/objects.c b/hw/misc/nvfwd/objects.c
index 2c051b2..e5f59e8 100644
--- a/hw/misc/nvfwd/objects.c
+++ b/hw/misc/nvfwd/objects.c
@@ -131,6 +131,10 @@ void objects_add(Objects *o, const ObjectClaim *claim, uint64_t bytes, const Obj
     e->info.timeslice_us = 0;
     e->info.timeslice_errno = 0;
     e->info.timeslice_status = 0;
+    e->info.interleave_requested = e->info.interleave_attempted = false;
+    e->info.interleave_level = 0;
+    e->info.interleave_errno = 0;
+    e->info.interleave_status = 0;
     drop_claim(o, claim);
     /* A handle used again means the driver dropped the old object without being asked here. */
     if (find(o, info->client, info->object)) {
@@ -313,3 +317,22 @@ bool objects_timeslice_result(Objects *o, const ObjectInfo *ref, uint64_t us,
     g_mutex_unlock(&o->lock);
     return same;
 }
+
+bool objects_interleave_result(Objects *o, const ObjectInfo *ref, uint32_t level,
+                               int error, uint32_t status)
+{
+    Entry *e;
+    bool same;
+    g_mutex_lock(&o->lock);
+    e = find(o, ref->client, ref->object);
+    same = e && ref->generation && e->info.generation == ref->generation;
+    if (same) {
+        e->info.interleave_requested = true;
+        e->info.interleave_attempted = ref->tsg_owned;
+        e->info.interleave_level = level;
+        e->info.interleave_errno = error;
+        e->info.interleave_status = status;
+    }
+    g_mutex_unlock(&o->lock);
+    return same;
+}
