diff --git a/hw/misc/nvfwd/nvfwd.c b/hw/misc/nvfwd/nvfwd.c
index ec37ec0..ac29a38 100644
--- a/hw/misc/nvfwd/nvfwd.c
+++ b/hw/misc/nvfwd/nvfwd.c
@@ -333,6 +333,41 @@ static void nvfwd_get_timeslice_status(Object *obj, Visitor *v, const char *name
     g_free(text);
 }
 
+static void nvfwd_set_interleave(Object *obj, Visitor *v, const char *name,
+                                  void *opaque, Error **errp)
+{
+    NvfwdState *s = NVFWD(obj);
+    int64_t level;
+    uint32_t failed;
+    if (!nvfwd_budget_ready(obj, errp) ||
+        !visit_type_int64(v, name, &level, errp)) {
+        return;
+    }
+    if (s->no_gpu || level < 0 || level > 2) {
+        error_setg(errp, "interleave-level requires a GPU and LOW=0, MEDIUM=1 or HIGH=2");
+        return;
+    }
+    if (!interleave_set(&s->timeslice, level, host_interleave_apply, s, &failed)) {
+        error_setg(errp, "invalid interleave level");
+    } else if (failed) {
+        error_setg(errp, "interleave policy retained; %u TSG references failed; read interleave-status",
+                   failed);
+    }
+}
+
+static void nvfwd_get_interleave_status(Object *obj, Visitor *v, const char *name,
+                                        void *opaque, Error **errp)
+{
+    NvfwdState *s = NVFWD(obj);
+    char *text;
+    if (!nvfwd_budget_ready(obj, errp)) {
+        return;
+    }
+    text = interleave_report(&s->timeslice);
+    visit_type_str(v, name, &text, errp);
+    g_free(text);
+}
+
 static const Property nvfwd_props[] = {
     DEFINE_PROP_STRING("allow", NvfwdState, allow_path),
     DEFINE_PROP_STRING("sensord", NvfwdState, sensord_path),
@@ -381,6 +416,14 @@ static void nvfwd_class_init(ObjectClass *class, const void *data)
                               nvfwd_get_timeslice_status, NULL, NULL, NULL);
     object_class_property_set_description(class, "timeslice-status",
         "Per-owned-reference generation and last actual timeslice errno/RM status");
+    object_class_property_add(class, "interleave-level", "uint32",
+                              NULL, nvfwd_set_interleave, NULL, NULL);
+    object_class_property_set_description(class, "interleave-level",
+        "Host-only requested LOW=0/MEDIUM=1/HIGH=2; read interleave-status for unset/outcomes");
+    object_class_property_add(class, "interleave-status", "str",
+                              nvfwd_get_interleave_status, NULL, NULL, NULL);
+    object_class_property_set_description(class, "interleave-status",
+        "Bounded requested interleave and per-reference RM outcomes; not hardware priority/weight");
     set_bit(DEVICE_CATEGORY_MISC, dc->categories);
 }
 
