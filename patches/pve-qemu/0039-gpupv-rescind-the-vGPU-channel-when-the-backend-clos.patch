+/*
+ * Withdrawing an offered channel, for a device whose backend has gone away.
+ * The guest answers a rescind with RELID_RELEASED once it has dropped the
+ * channel; only then may the same relid be offered again.
+ */
+enum {
+    VMRESCIND_NONE,
+    VMRESCIND_PENDING,      /* asked for, not yet posted */
+    VMRESCIND_SENDING,
+    VMRESCIND_SENT,         /* waiting for the guest to release the relid */
+    VMRESCIND_RELEASED,     /* guest let go; offer it again when asked */
+    VMRESCIND_REOFFER,      /* offer again, not yet posted */
+    VMRESCIND_REOFFERING,
+};
+
 struct VMBusChannel {
     VMBusDevice *dev;
 
@@ -157,6 +172,9 @@ struct VMBusChannel {
     uint8_t offer_state;
     uint8_t state;
     bool is_open;
+    uint8_t rescind_state;
+    /* offer again as soon as the guest releases the relid */
+    bool reoffer_wanted;
 
     /* main device worker; copied from the device class */
     VMBusChannelNotifyCb notify_cb;
@@ -212,6 +230,8 @@ enum {
     VMBUS_TEARDOWN_GPADL,
     VMBUS_OPEN_CHANNEL,
     VMBUS_UNLOAD,
+    VMBUS_RESCIND,
+    VMBUS_REOFFER,
     VMBUS_STATE_MAX
 };
 
@@ -1641,6 +1661,8 @@ static void vmbus_deinit(VMBus *vmbus)
 
     QTAILQ_FOREACH(chan, &vmbus->channel_list, link) {
         chan->offer_state = VMOFFER_INIT;
+        chan->rescind_state = VMRESCIND_NONE;
+        chan->reoffer_wanted = false;
     }
 
     hyperv_sint_route_unref(vmbus->sint_route);
@@ -1715,6 +1737,31 @@ static void handle_request_offers(VMBus *vmbus, void *msgdata, uint32_t msglen)
     vmbus->state = VMBUS_OFFER;
 }
 
+static void post_offer(VMBus *vmbus, VMBusChannel *chan)
+{
+    VMBusDeviceClass *vdc = VMBUS_DEVICE_GET_CLASS(chan->dev);
+    /* Hyper-V wants LE GUIDs */
+    QemuUUID classid = qemu_uuid_bswap(vdc->classid);
+    QemuUUID instanceid = qemu_uuid_bswap(chan->dev->instanceid);
+    struct vmbus_message_offer_channel msg = {
+        .header.message_type = VMBUS_MSG_OFFERCHANNEL,
+        .child_relid = chan->id,
+        .connection_id = chan_connection_id(chan),
+        .channel_flags = vdc->channel_flags,
+        .mmio_size_mb = vdc->mmio_size_mb,
+        .sub_channel_index = vmbus_channel_idx(chan),
+        .interrupt_flags = VMBUS_OFFER_INTERRUPT_DEDICATED,
+    };
+
+    memcpy(msg.type_uuid, &classid, sizeof(classid));
+    memcpy(msg.instance_uuid, &instanceid, sizeof(instanceid));
+    memcpy(msg.user_data, &vdc->pipe_mode, sizeof(vdc->pipe_mode));
+
+    trace_vmbus_send_offer(chan->id, chan->dev);
+
+    post_msg(vmbus, &msg, sizeof(msg));
+}
