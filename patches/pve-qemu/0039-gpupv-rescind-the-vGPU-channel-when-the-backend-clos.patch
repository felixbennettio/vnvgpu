+static void gpupv_chr_event(void *opaque, QEMUChrEvent event)
+{
+    GpupvChannel *s = opaque;
+    VMBusChannel *chan = vmbus_device_channel(VMBUS_DEVICE(s), 0);
+    const char *name = object_get_typename(OBJECT(s));
+
+    switch (event) {
+    case CHR_EVENT_CLOSED:
+        if (s->backend_lost) {
+            return;
+        }
+        s->backend_lost = true;
+        gpupv_drop_pending(s);
+        g_byte_array_set_size(s->rx, 0);
+        if (s->arena_fd >= 0) {
+            close(s->arena_fd);
+            s->arena_fd = -1;
+        }
+        warn_report("%s: backend closed%s", name,
+                    s->rescind_on_loss ? ", rescinding the channel" : "");
+        if (s->rescind_on_loss && chan) {
+            vmbus_channel_rescind(chan);
+        }
+        break;
+    case CHR_EVENT_OPENED:
+        /* The first connection is opened before the guest is offered anything. */
+        if (!s->backend_lost) {
+            return;
+        }
+        s->backend_lost = false;
+        s->write_failed = false;
+        info_report("%s: backend connected again", name);
+        if (s->rescind_on_loss && chan) {
+            vmbus_channel_reoffer(chan);
+        }
+        break;
+    default:
+        break;
+    }
+}
