+static void process_message(VMBus *vmbus);
+
+void vmbus_channel_rescind(VMBusChannel *chan)
+{
+    /* Only a channel the guest was told about can be taken back. */
+    if (chan->offer_state != VMOFFER_SENT) {
+        return;
+    }
+    switch (chan->rescind_state) {
+    case VMRESCIND_NONE:
+        chan->rescind_state = VMRESCIND_PENDING;
+        break;
+    case VMRESCIND_REOFFER:
+        /* never posted the new offer: the guest still has nothing */
+        chan->rescind_state = VMRESCIND_RELEASED;
+        break;
+    default:
+        break;
+    }
+    chan->reoffer_wanted = false;
+    vmbus_resched(chan->vmbus);
+}
+
+void vmbus_channel_reoffer(VMBusChannel *chan)
+{
+    switch (chan->rescind_state) {
+    case VMRESCIND_PENDING:
+        /* back before the guest heard anything */
+        chan->rescind_state = VMRESCIND_NONE;
+        break;
+    case VMRESCIND_SENDING:
+    case VMRESCIND_SENT:
+        chan->reoffer_wanted = true;
+        break;
+    case VMRESCIND_RELEASED:
+        chan->rescind_state = VMRESCIND_REOFFER;
+        vmbus_resched(chan->vmbus);
+        break;
+    default:
+        break;
+    }
+}
+
+bool vmbus_channel_is_rescinded(VMBusChannel *chan)
+{
+    return chan->rescind_state != VMRESCIND_NONE;
+}
+
+static void send_rescind(VMBus *vmbus)
+{
+    VMBusChannel *chan;
+
+    QTAILQ_FOREACH(chan, &vmbus->channel_list, link) {
+        if (chan->rescind_state == VMRESCIND_SENDING) {
+            vmbus_message_rescind_channel_offer msg = {
+                .header.message_type = VMBUS_MSG_RESCIND_CHANNELOFFER,
+                .child_relid = chan->id,
+            };
+
+            trace_vmbus_rescind(chan->id);
+            post_msg(vmbus, &msg, sizeof(msg));
+            return;
+        }
+    }
+
+    g_assert_not_reached();
+}
+
+static bool complete_rescind(VMBus *vmbus)
+{
+    VMBusChannel *chan;
+
+    QTAILQ_FOREACH(chan, &vmbus->channel_list, link) {
+        if (chan->rescind_state == VMRESCIND_SENDING) {
+            chan->rescind_state = VMRESCIND_SENT;
+            info_report("vmbus: rescinded channel #%u", chan->id);
+            return true;
+        }
+    }
+
+    g_assert_not_reached();
+}
+
+static void send_reoffer(VMBus *vmbus)
+{
+    VMBusChannel *chan;
+
+    QTAILQ_FOREACH(chan, &vmbus->channel_list, link) {
+        if (chan->rescind_state == VMRESCIND_REOFFERING) {
+            post_offer(vmbus, chan);
+            return;
+        }
+    }
+
+    g_assert_not_reached();
+}
+
+static bool complete_reoffer(VMBus *vmbus)
+{
+    VMBusChannel *chan;
+
+    QTAILQ_FOREACH(chan, &vmbus->channel_list, link) {
+        if (chan->rescind_state == VMRESCIND_REOFFERING) {
+            chan->rescind_state = VMRESCIND_NONE;
+            info_report("vmbus: offered channel #%u again", chan->id);
+            return true;
+        }
+    }
+
+    g_assert_not_reached();
+}
+
+static void handle_relid_released(VMBus *vmbus,
+                                  vmbus_message_close_channel *msg,
+                                  uint32_t msglen)
+{
+    VMBusChannel *chan;
+    VMBusGpadl *gpadl, *tmp;
+
+    /* RELID_RELEASED has the same layout as CLOSECHANNEL: header, relid. */
+    if (msglen < sizeof(*msg) || !vmbus_initialized(vmbus)) {
+        return;
+    }
+
+    trace_vmbus_relid_released(msg->child_relid);
+
+    chan = find_channel(vmbus, msg->child_relid);
+    if (!chan || chan->rescind_state != VMRESCIND_SENT) {
+        error_report("vmbus: guest released relid %u that was not rescinded",
+                     msg->child_relid);
+        return;
+    }
+
+    close_channel(chan);
+    chan->state = VMCHAN_INIT;
+
+    /*
+     * A guest drops the ring buffer GPADLs of a rescinded channel without
+     * tearing them down, as the host is not expected to answer any more.
+     */
+    QTAILQ_FOREACH_SAFE(gpadl, &vmbus->gpadl_list, link, tmp) {
+        if (gpadl->child_relid == chan->id && gpadl->state == VMGPADL_ALIVE) {
+            gpadl->state = VMGPADL_TORNDOWN;
+            vmbus_put_gpadl(gpadl);
+        }
+    }
+
+    info_report("vmbus: guest released channel #%u", chan->id);
+    chan->rescind_state = chan->reoffer_wanted ? VMRESCIND_REOFFER
+                                               : VMRESCIND_RELEASED;
+    chan->reoffer_wanted = false;
+
+    vdev_reset_on_close(chan->dev);
+}
+
+/*
+ * Host-initiated work goes first: a rescind or a new offer is a message of
+ * our own, so it can only be posted from the state machine.
+ */
+static void vmbus_listen(VMBus *vmbus)
+{
+    VMBusChannel *chan;
+
+    if (vmbus_initialized(vmbus)) {
+        QTAILQ_FOREACH(chan, &vmbus->channel_list, link) {
+            if (chan->rescind_state == VMRESCIND_PENDING) {
+                chan->rescind_state = VMRESCIND_SENDING;
+                vmbus->state = VMBUS_RESCIND;
+                vmbus_resched(vmbus);
+                return;
+            }
+            if (chan->rescind_state == VMRESCIND_REOFFER) {
+                chan->rescind_state = VMRESCIND_REOFFERING;
+                vmbus->state = VMBUS_REOFFER;
+                vmbus_resched(vmbus);
+                return;
+            }
+        }
+    }
+
+    process_message(vmbus);
+}
+
 static void process_message(VMBus *vmbus)
 {
     struct hyperv_post_message_input *hv_msg;
@@ -2135,6 +2345,9 @@ static void process_message(VMBus *vmbus)
     case VMBUS_MSG_UNLOAD:
         handle_unload(vmbus, msgdata, msglen);
         break;
+    case VMBUS_MSG_RELID_RELEASED:
+        handle_relid_released(vmbus, msgdata, msglen);
+        break;
     default:
         error_report("unknown message type %#x", msg->message_type);
         break;
@@ -2152,13 +2365,15 @@ static const struct {
     void (*run)(VMBus *vmbus);
     bool (*complete)(VMBus *vmbus);
 } state_runner[] = {
-    [VMBUS_LISTEN]         = {process_message,     NULL},
+    [VMBUS_LISTEN]         = {vmbus_listen,        NULL},
     [VMBUS_HANDSHAKE]      = {send_handshake,      NULL},
     [VMBUS_OFFER]          = {send_offer,          complete_offer},
     [VMBUS_CREATE_GPADL]   = {send_create_gpadl,   complete_create_gpadl},
     [VMBUS_TEARDOWN_GPADL] = {send_teardown_gpadl, complete_teardown_gpadl},
     [VMBUS_OPEN_CHANNEL]   = {send_open_channel,   complete_open_channel},
     [VMBUS_UNLOAD]         = {send_unload,         complete_unload},
+    [VMBUS_RESCIND]        = {send_rescind,        complete_rescind},
+    [VMBUS_REOFFER]        = {send_reoffer,        complete_reoffer},
 };
 
 static void vmbus_do_run(VMBus *vmbus)
