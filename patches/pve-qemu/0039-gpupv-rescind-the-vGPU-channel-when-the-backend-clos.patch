+/*
+ * Withdraw the offer of @chan, for a device that lost its backend: the guest
+ * drops the channel instead of waiting on it.  vmbus_channel_reoffer() offers
+ * it again once the guest has released it.
+ */
+void vmbus_channel_rescind(VMBusChannel *chan);
+void vmbus_channel_reoffer(VMBusChannel *chan);
+bool vmbus_channel_is_rescinded(VMBusChannel *chan);
+
