diff --git a/hw/misc/nvfwd/rusd.h b/hw/misc/nvfwd/rusd.h
index 6648b24..608281b 100644
--- a/hw/misc/nvfwd/rusd.h
+++ b/hw/misc/nvfwd/rusd.h
@@ -39,11 +39,24 @@
 
 typedef struct Rusd Rusd;
 
+/*
+ * The card the VM was given, as the device looked it up: its device file's minor, the RM's GPU id
+ * and the RM's device instance. QEMU passes them to the daemon as its three arguments.
+ */
+typedef struct RusdCard {
+    uint32_t minor, gpu_id, instance;
+} RusdCard;
+
+#define RUSD_CARD_ARGUMENTS 3
+
+/* Reads the daemon's arguments, as decimal or 0x hex. */
+bool rusd_card_parse(int argc, char *const argv[], RusdCard *card);
+
 /*
  * page_fd is the file the filtered page goes in, RUSD_MAP_BYTES long. NULL when the host driver is
  * not the one the page layout was read from, or has no such page.
  */
-Rusd *rusd_open(int page_fd);
+Rusd *rusd_open(int page_fd, const RusdCard *card);
 void rusd_close(Rusd *r);
 
 /* Tells the host which data to keep fresh. Zero stops the polling, which costs the whole card. */
