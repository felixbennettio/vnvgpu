 #define CTRL_REQUEST_DATA_POLL 0xde0001
 
@@ -166,20 +166,36 @@ static bool driver_matches(void)
     return !strcmp(version, DRIVER_VERSION);
 }
 
-static int attach_first_gpu(Rusd *r)
+static int attach_card(Rusd *r, const RusdCard *card)
 {
-    uint32_t probed[MAX_GPUS * 3] = { 0 };
     uint32_t attach[MAX_GPUS + 1];
 
-    if (rm_control(r, r->client, CTRL_GET_PROBED_IDS, probed, sizeof(probed))) {
-        return -1;
-    }
     memset(attach, 0xff, sizeof(attach));
-    attach[0] = probed[0];
+    attach[0] = card->gpu_id;
     if (rm_control(r, r->client, CTRL_ATTACH_IDS, attach, sizeof(attach))) {
         return -1;
     }
-    return rm_call(r->control_fd, ESC_ATTACH_GPUS_TO_FD, probed, sizeof(probed[0]));
+    return rm_call(r->control_fd, ESC_ATTACH_GPUS_TO_FD, &attach[0], sizeof(attach[0]));
+}
+
+static bool parse_number(const char *text, uint32_t *value)
+{
+    char *end;
+    unsigned long n;
+
+    errno = 0;
+    n = strtoul(text, &end, 0);
+    if (errno || end == text || *end || n > UINT32_MAX) {
+        return false;
+    }
+    *value = n;
+    return true;
+}
+
+bool rusd_card_parse(int argc, char *const argv[], RusdCard *card)
+{
+    return argc == RUSD_CARD_ARGUMENTS + 1 && parse_number(argv[1], &card->minor) &&
+           parse_number(argv[2], &card->gpu_id) && parse_number(argv[3], &card->instance);
 }
 
