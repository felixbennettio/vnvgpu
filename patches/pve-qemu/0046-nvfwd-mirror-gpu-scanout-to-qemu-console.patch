     s->surf_h[id] = height;
     s->surf_pitch[id] = pitch;
@@ -276,6 +453,9 @@ void do_show_frame(NvfwdState *s, struct
     s->show_sequence++;
     qatomic_set(s->show_latest, s->show_sequence << 8 | slot);
     qemu_mutex_unlock(&s->show_lock);
+    if (s->console_bh) {
+        qemu_bh_schedule(s->console_bh);
+    }
     r->ret = 0;
 }
 
@@ -318,5 +498,13 @@ void show_init(NvfwdState *s, Error **er
         error_setg_errno(errp, errno, "nvfwd screen socket");
         return;
     }
+    if (s->show_console) {
+#if defined(CONFIG_OPENGL) && defined(CONFIG_GBM)
+        s->console_bh = qemu_bh_new(show_console_refresh, s);
+#else
+        error_setg(errp, "nvfwd console mirror requires OpenGL and GBM support");
+        return;
+#endif
+    }
     qemu_thread_create(&s->show_thread, "nvfwd-show", show_listen, s, QEMU_THREAD_DETACHED);
 }
