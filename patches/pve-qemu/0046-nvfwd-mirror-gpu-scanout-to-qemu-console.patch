Index: pve-qemu-kvm-11.1.3/hw/misc/nvfwd/show.c
===================================================================
--- pve-qemu-kvm-11.1.3.orig/hw/misc/nvfwd/show.c
+++ pve-qemu-kvm-11.1.3/hw/misc/nvfwd/show.c
@@ -11,6 +11,9 @@
 #include <sys/socket.h>
 #include <sys/un.h>
 #include "nvfwd.h"
+#if defined(CONFIG_OPENGL) && defined(CONFIG_GBM)
+#include "ui/egl-helpers.h"
+#endif
 
 #define DISPLAY_LATEST 0x40 /* newest finished frame: sequence << 8 | slot */
 #define DISPLAY_HELD 0x48 /* the slots the viewer still needs, written by the viewer */
@@ -25,6 +28,172 @@
 #define NVKMS_LAYOUT_PITCH 1
 #define MODIFIER_NVIDIA_BLOCK_LINEAR 0x0300000000606010ull /* sector layout 1, generation 2, kind 6, as the guest driver offers; low bits are log2 height */
 
+/* The normal PVE console can mirror the GPU's actual scanout. The GPU still
+ * renders the desktop; egl-headless only reads it back for software VNC clients.
+ * This owns the frame-consumer protocol when enabled (no second native viewer).
+ */
+#if defined(CONFIG_OPENGL) && defined(CONFIG_GBM)
+static void show_console_refresh(void *opaque);
+
+static bool show_console_gfx_update(void *opaque)
+{
+    show_console_refresh(opaque);
+    return true;
+}
+
+static const GraphicHwOps show_console_ops = {
+    .gfx_update = show_console_gfx_update,
+};
+
+static void show_console_refresh(void *opaque)
+{
+    NvfwdState *s = opaque;
+    QemuDmaBuf *buffer;
+    DisplaySurface *surface;
+    egl_fb scanout = EGL_FB_INIT;
+    uint32_t slot, width = 0, height = 0, pitch = 0, fourcc = 0, offset = 0;
+    uint64_t sequence, modifier = 0, generation;
+    int fd = -1;
+    EGLContext old_context;
+    EGLDisplay old_display;
+    EGLSurface old_draw, old_read;
+
+    qemu_mutex_lock(&s->show_lock);
+    slot = s->show_newest;
+    sequence = s->show_sequence;
+    if (slot >= NVFWD_SHOW_MAX_SURFACES || sequence == s->console_sequence ||
+        (s->show_pending & (1u << slot))) {
+        qemu_mutex_unlock(&s->show_lock);
+        return;
+    }
+    if (s->console_surface_mask & (1u << slot)) {
+        fd = s->surf_fd[slot];
+        width = s->surf_w[slot];
+        height = s->surf_h[slot];
+        pitch = s->surf_pitch[slot];
+        fourcc = s->surf_format[slot];
+        modifier = s->surf_modifier[slot];
+    } else if (slot < NVFWD_SHOW_SLOTS && (s->show_ready & (1u << slot))) {
+        fd = s->show_fd[slot];
+        width = s->show_w;
+        height = s->show_h;
+        pitch = s->show_pitch;
+        fourcc = 0x34325258; /* DRM_FORMAT_XRGB8888, as the native viewer uses. */
+        modifier = 0;
+    }
+    if (fd < 0 || !width || !height || width > 8192 || height > 4320) {
+        qemu_mutex_unlock(&s->show_lock);
+        return;
+    }
+    generation = s->console_generation[slot];
+    if (!s->console_buffers[slot] ||
+        s->console_cached_generation[slot] != generation) {
+        fd = fcntl(fd, F_DUPFD_CLOEXEC, 0);
+        if (fd < 0) {
+            qemu_mutex_unlock(&s->show_lock);
+            return;
+        }
+    } else {
+        fd = -1;
+    }
+    qatomic_set(s->show_held, 1u << slot);
+    qatomic_set(s->show_reading, qatomic_read(s->show_present + slot));
+    qemu_mutex_unlock(&s->show_lock);
+
+    if (!s->console) {
+        s->console = qemu_console_lookup_by_index(0);
+    }
+    if (!s->console || !qemu_console_is_graphic(s->console) ||
+        !qemu_console_has_gl(s->console) || qemu_egl_rn_ctx == EGL_NO_CONTEXT) {
+        if (!s->console_error_reported) {
+            fprintf(s->log, "show: console mirror needs a graphical console and -display egl-headless\n");
+            fflush(s->log);
+            s->console_error_reported = true;
+        }
+        if (fd >= 0) {
+            close(fd);
+        }
+        goto release;
+    }
+    old_context = eglGetCurrentContext();
+    old_display = eglGetCurrentDisplay();
+    old_draw = eglGetCurrentSurface(EGL_DRAW);
+    old_read = eglGetCurrentSurface(EGL_READ);
+    if (!eglMakeCurrent(qemu_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+                        qemu_egl_rn_ctx)) {
+        if (!s->console_error_reported) {
+            fprintf(s->log, "show: cannot make the console EGL context current: %s\n",
+                    qemu_egl_get_error_string());
+            fflush(s->log);
+            s->console_error_reported = true;
+        }
+        if (fd >= 0) {
+            close(fd);
+        }
+        goto release;
+    }
+    if (fd >= 0) {
+        buffer = s->console_buffers[slot];
+        if (buffer) {
+            qemu_console_gl_release_dmabuf(s->console, buffer);
+            qemu_dmabuf_close(buffer);
+            qemu_dmabuf_free(buffer);
+        }
+        buffer = qemu_dmabuf_new(width, height, &offset, &pitch, 0, 0,
+                                  width, height, fourcc, modifier, &fd, 1,
+                                  false, false);
+        s->console_buffers[slot] = buffer;
+        s->console_cached_generation[slot] = generation;
+    }
+    buffer = s->console_buffers[slot];
+    egl_dmabuf_import_texture(buffer);
+    if (!qemu_dmabuf_get_texture(buffer)) {
+        if (!s->console_error_reported) {
+            fprintf(s->log, "show: console EGL import failed, slot %u format %#x modifier %#llx\n",
+                    slot, fourcc, (unsigned long long)modifier);
+            fflush(s->log);
+            s->console_error_reported = true;
+        }
+        goto restore;
+    }
+    if (!s->console_hooked) {
+        qemu_graphic_console_set_hwops(s->console, &show_console_ops, s);
+        s->console_hooked = true;
+        fprintf(s->log, "show: GPU scanout is now mirrored to the PVE console (%ux%u)\n",
+                width, height);
+        fflush(s->log);
+    }
+    /* Keep a CPU-facing surface attached for the VNC and QMP listeners. */
+    qemu_console_resize(s->console, width, height);
+    surface = qemu_console_surface(s->console);
+    egl_fb_setup_for_tex(&scanout, width, height,
+                         qemu_dmabuf_get_texture(buffer), false);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+        egl_fb_destroy(&scanout);
+        goto restore;
+    }
+    egl_fb_read(surface, &scanout);
+    egl_fb_destroy(&scanout);
+    qemu_console_update_full(s->console);
+    s->console_sequence = sequence;
+    s->console_error_reported = false;
+    /* 60 Hz target refresh, and a count of actual copied GPU frames. */
+    s->console_refresh_count++;
+    qatomic_set(s->show_rate,
+                (uint64_t)s->console_refresh_count << 32 | 16666666u);
+restore:
+    if (old_context != qemu_egl_rn_ctx) {
+        eglMakeCurrent(old_display == EGL_NO_DISPLAY ? qemu_egl_display : old_display,
+                        old_draw, old_read, old_context);
+    }
+release:
+    qemu_mutex_lock(&s->show_lock);
+    qatomic_set(s->show_reading, 0);
+    qatomic_set(s->show_held, 0);
+    qemu_mutex_unlock(&s->show_lock);
+}
+#endif
+
