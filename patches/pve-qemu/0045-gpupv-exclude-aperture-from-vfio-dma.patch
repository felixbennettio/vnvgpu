0045-gpupv-exclude-aperture-from-vfio-dma.patch

Index: pve-qemu-kvm-11.1.3/hw/hyperv/gpupv.c
===================================================================
--- pve-qemu-kvm-11.1.3.orig/hw/hyperv/gpupv.c
+++ pve-qemu-kvm-11.1.3/hw/hyperv/gpupv.c
@@ -85,6 +85,7 @@ struct GpupvChannel {
     /* Memory shared with the backend, for fences. Only the global channel has it. */
     HostMemoryBackend *iomem;
     uint64_t iomem_base;
+    MemoryRegion iomem_window;
 
     /* Memory the backend hands over later, see GPUPV_EVT_ARENA. */
     MemoryRegion arena;
@@ -458,8 +459,19 @@ static void gpupv_vmdev_realize(VMBusDev
     if (s->iomem) {
         MemoryRegion *mr = host_memory_backend_get_memory(s->iomem);
 
+        /* This is a device aperture, not guest RAM or a physical-device DMA
+         * target. Mapping all 64 GiB into a VFIO IOMMU eagerly pins it and can
+         * exhaust the host when an otherwise unrelated device is passed through.
+         * Keep the same shared backing and GPA while excluding the aperture.
+         */
+        memory_region_init_ram_device_ptr(&s->iomem_window, OBJECT(s),
+                                          "gpupv-iomem-window",
+                                          memory_region_size(mr),
+                                          memory_region_get_ram_ptr(mr));
+        memory_region_set_skip_iommu_map(&s->iomem_window, true);
         host_memory_backend_set_mapped(s->iomem, true);
-        memory_region_add_subregion_overlap(get_system_memory(), s->iomem_base, mr, 1);
+        memory_region_add_subregion_overlap(get_system_memory(), s->iomem_base,
+                                            &s->iomem_window, 1);
     }
 }
 
@@ -469,6 +481,10 @@ static void gpupv_vmdev_unrealize(VMBusD
 
     gpupv_drop_pending(s);
     gpupv_drop_arena(s);
+    if (s->iomem) {
+        memory_region_del_subregion(get_system_memory(), &s->iomem_window);
+        host_memory_backend_set_mapped(s->iomem, false);
+    }
     g_byte_array_free(s->rx, true);
     g_hash_table_destroy(s->unanswered);
     qemu_chr_fe_deinit(&s->chr, false);
