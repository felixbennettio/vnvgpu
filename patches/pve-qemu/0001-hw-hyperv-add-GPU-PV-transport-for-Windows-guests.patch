diff --git a/hw/hyperv/vmbus.c b/hw/hyperv/vmbus.c
index ab99f08..b36b39f 100644
--- a/hw/hyperv/vmbus.c
+++ b/hw/hyperv/vmbus.c
@@ -2686,6 +2686,8 @@ static const VMStateDescription vmstate_vmbus_bridge = {
 
 static const Property vmbus_bridge_props[] = {
     DEFINE_PROP_UINT8("irq", VMBusBridge, irq, 7),
+    DEFINE_PROP_UINT64("mmio-base", VMBusBridge, mmio_base, 0),
+    DEFINE_PROP_UINT64("mmio-size", VMBusBridge, mmio_size, 0),
 };
 
 static void vmbus_bridge_class_init(ObjectClass *klass, const void *data)
diff --git a/hw/i386/acpi-build.c b/hw/i386/acpi-build.c
index 8837b69..2f417a6 100644
--- a/hw/i386/acpi-build.c
+++ b/hw/i386/acpi-build.c
@@ -472,6 +472,24 @@ static Aml *build_vmbus_device_aml(VMBusBridge *vmbus_bridge)
     aml_append(crs, aml_irq_no_flags(vmbus_bridge->irq));
     aml_append(dev, aml_name_decl("_CRS", crs));
 
+    if (vmbus_bridge->mmio_size) {
+        Aml *vmod = aml_device("VMOD");
+
+        aml_append(vmod, aml_name_decl("_HID", aml_string("ACPI0004")));
+        aml_append(vmod, aml_name_decl("_UID", aml_int(0x0)));
+        crs = aml_resource_template();
+        aml_append(crs, aml_qword_memory(AML_POS_DECODE, AML_MIN_FIXED,
+                                         AML_MAX_FIXED, AML_NON_CACHEABLE,
+                                         AML_READ_WRITE, 0,
+                                         vmbus_bridge->mmio_base,
+                                         vmbus_bridge->mmio_base +
+                                         vmbus_bridge->mmio_size - 1,
+                                         0, vmbus_bridge->mmio_size));
+        aml_append(vmod, aml_name_decl("_CRS", crs));
+        aml_append(vmod, dev);
+        return vmod;
+    }
+
     return dev;
 }
 
