[PATCH 22/43] hw/misc/nvfwd: a guest keeps its sensor page with no daemon

diff --git a/hw/misc/nvfwd/sensors.c b/hw/misc/nvfwd/sensors.c
index 941b352..003a812 100644
--- a/hw/misc/nvfwd/sensors.c
+++ b/hw/misc/nvfwd/sensors.c
@@ -5,6 +5,8 @@
 #include "sensors.h"
 #include "rusd.h"
 
+#include <poll.h>
+#include <signal.h>
 #include <spawn.h>
 #include <sys/socket.h>
 
@@ -60,6 +62,9 @@
 #define MAX_MAPPING_FILES 4096
 #define MAX_REFUSALS_LOGGED 64
 
+/* A guest's call waits on the daemon, on its vCPU, so a stuck daemon may stall a VM but never hang it. */
+#define DAEMON_ANSWER_SECONDS 5
+
 typedef struct {
     uint32_t client, object, file;
     uint64_t mask;
@@ -71,7 +76,6 @@ struct Sensors {
     const char *daemon_path;
     QemuMutex lock;
     int daemon, page_fd;
-    bool unavailable;
     uint64_t polling;
     SensorObject objects[MAX_OBJECTS];
     bool mapping_next[MAX_MAPPING_FILES];
@@ -118,55 +122,123 @@ static bool spawn_daemon(Sensors *s, int socket_end, int page_fd)
 {
     char *const argv[] = { (char *)s->daemon_path, NULL };
     posix_spawn_file_actions_t actions;
+    posix_spawnattr_t attributes;
+    sigset_t none;
     pid_t pid;
     int rc;
 
     posix_spawn_file_actions_init(&actions);
     posix_spawn_file_actions_adddup2(&actions, socket_end, SENSORD_SOCKET_FD);
     posix_spawn_file_actions_adddup2(&actions, page_fd, SENSORD_PAGE_FD);
-    rc = posix_spawn(&pid, s->daemon_path, &actions, NULL, argv, environ);
+    /* This runs on a vCPU, which blocks every signal: the daemon must still go when it's told to. */
+    sigemptyset(&none);
+    posix_spawnattr_init(&attributes);
+    posix_spawnattr_setsigmask(&attributes, &none);
+    posix_spawnattr_setflags(&attributes, POSIX_SPAWN_SETSIGMASK);
+    rc = posix_spawn(&pid, s->daemon_path, &actions, &attributes, argv, environ);
+    posix_spawnattr_destroy(&attributes);
     posix_spawn_file_actions_destroy(&actions);
     return !rc;
 }
 
-/* The daemon comes up with the first guest that asks, and stays until the VM ends. */
-static bool start_page(Sensors *s)
+/* A page of zeros reads as no readings, which is what a guest should see when nothing fills it in. */
+static void clear_page(Sensors *s)
 {
+    static const uint8_t zeros[RUSD_MAP_BYTES];
+
+    if (pwrite(s->page_fd, zeros, sizeof(zeros), 0) != sizeof(zeros)) {
+        fprintf(s->log, "sensors: could not clear the page, so its readings stay old\n");
+    }
+}
+
+/* Sensors are a nicety. Losing them must never cost a guest its GPU, so the page stays. */
+static void go_without_daemon(Sensors *s, const char *why)
+{
+    fprintf(s->log, "sensors: no readings from here on, as %s\n", why);
+    fflush(s->log);
+    if (s->daemon >= 0) {
+        close(s->daemon);
+        s->daemon = -1;
+    }
+    s->polling = 0;
+    clear_page(s);
+}
+
+static void start_daemon(Sensors *s)
+{
+    struct timeval patience = { .tv_sec = DAEMON_ANSWER_SECONDS };
     uint32_t client = 0;
     int ends[2];
 
-    if (s->daemon >= 0 || s->unavailable) {
-        return s->daemon >= 0;
+    if (!s->daemon_path) {
+        go_without_daemon(s, "QEMU was given no sensor daemon");
