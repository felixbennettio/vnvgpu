-    s->unavailable = false;
+}
+
+/*
+ * The page comes with the first guest that asks, and stays until the VM ends. NVIDIA's user-mode
+ * driver won't start without this object, so a guest gets one with or without a daemon to fill it.
+ */
+static bool start_page(Sensors *s)
+{
+    if (s->page_fd >= 0) {
+        return true;
+    }
+    s->page_fd = memfd_create("nvfwd-sensors", MFD_CLOEXEC);
+    if (s->page_fd < 0) {
+        return false;
+    }
+    if (ftruncate(s->page_fd, RUSD_MAP_BYTES)) {
+        close(s->page_fd);
+        s->page_fd = -1;
+        return false;
+    }
+    start_daemon(s);
     return true;
 }
 
-static bool request_polling(Sensors *s, uint64_t mask)
+static void request_polling(Sensors *s, uint64_t mask)
 {
     int32_t status = -1;
 
-    return write(s->daemon, &mask, sizeof(mask)) == sizeof(mask) &&
-           read(s->daemon, &status, sizeof(status)) == sizeof(status) && !status;
+    if (write(s->daemon, &mask, sizeof(mask)) != sizeof(mask) ||
+        read(s->daemon, &status, sizeof(status)) != sizeof(status)) {
+        go_without_daemon(s, "the daemon stopped answering");
+    } else if (!status) {
+        s->polling = mask;
+    }
+}
+
+/* With no change to ask for, a dead daemon would go unnoticed, and its last readings would look live. */
+static void notice_dead_daemon(Sensors *s)
+{
+    struct pollfd socket_end = { .fd = s->daemon };
+
+    if (s->daemon >= 0 && poll(&socket_end, 1, 0) > 0 && (socket_end.revents & (POLLHUP | POLLERR))) {
+        go_without_daemon(s, "the daemon has gone");
+    }
 }
 
 /* The host polls what any guest object still wants, and nothing when none does. */
@@ -175,13 +247,14 @@ static void update_polling(Sensors *s)
     uint64_t wanted = 0;
     int i;
 
+    notice_dead_daemon(s);
     for (i = 0; i < MAX_OBJECTS; i++) {
         if (s->objects[i].used) {
             wanted |= s->objects[i].mask;
         }
     }
-    if (wanted != s->polling && s->daemon >= 0 && request_polling(s, wanted)) {
-        s->polling = wanted;
+    if (wanted != s->polling && s->daemon >= 0) {
+        request_polling(s, wanted);
     }
 }
 
