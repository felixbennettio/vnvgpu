+    setsockopt(ends[0], SOL_SOCKET, SO_RCVTIMEO, &patience, sizeof(patience));
+    setsockopt(ends[0], SOL_SOCKET, SO_SNDTIMEO, &patience, sizeof(patience));
     if (!spawn_daemon(s, ends[1], s->page_fd)) {
         close(ends[0]);
         close(ends[1]);
-        return false;
+        go_without_daemon(s, "the daemon would not start");
