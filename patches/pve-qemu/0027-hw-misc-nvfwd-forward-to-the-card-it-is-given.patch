diff --git a/hw/misc/nvfwd/forward.c b/hw/misc/nvfwd/forward.c
index 19e244b..17ae253 100644
--- a/hw/misc/nvfwd/forward.c
+++ b/hw/misc/nvfwd/forward.c
@@ -316,6 +316,21 @@ static void note_map_access(NvfwdState *s, const struct nvfwd_req *r, const uint
     }
 }
 
+/* A call naming a GPU or a device other than the guest's one card: see card.h. */
+static void refuse_other_card(NvfwdState *s, struct nvfwd_req *r, uint32_t nr, uint8_t *arg, uint32_t size)
+{
+    uint32_t status = nr == ESC_RM_ALLOC ? STATUS_INVALID_CLASS : STATUS_INVALID_ARGUMENT;
+    int status_at = nr == ESC_RM_CONTROL ? RM_CONTROL_STATUS : account_status_at(nr, size);
+
+    note_once(s, "REFUSED", "another card", KEY(K_CARD, nr), nr);
+    if (status_at < 0) {
+        r->ret = -EINVAL;
+        return;
+    }
+    memcpy(arg + status_at, &status, sizeof(status));
+    r->ret = 0;
+}
+
 static bool client_known(void *opaque, uint32_t client)
 {
     NvfwdState *s = opaque;
@@ -424,6 +439,10 @@ static void forward_ioctl(NvfwdState *s, Bounce *b, uint32_t *held, uint32_t *nh
             }
         }
     }
+    if (!uvm && !card_allows(&s->card, nr, arg, size)) {
+        refuse_other_card(s, r, nr, arg, size);
+        return;
+    }
     if (!uvm) {
         uint32_t refused;
 
@@ -433,6 +452,7 @@ static void forward_ioctl(NvfwdState *s, Bounce *b, uint32_t *held, uint32_t *nh
         refused = account_before(s->objects, &account, &hold);
