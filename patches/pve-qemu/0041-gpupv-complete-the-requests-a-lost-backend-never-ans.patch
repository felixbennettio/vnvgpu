[PATCH 41/43] gpupv: complete the requests a lost backend never answered, before the rescind

diff --git a/hw/hyperv/gpupv.c b/hw/hyperv/gpupv.c
index 17467d2..a78f223 100644
--- a/hw/hyperv/gpupv.c
+++ b/hw/hyperv/gpupv.c
@@ -103,6 +103,13 @@ struct GpupvChannel {
     bool backend_lost;
     bool write_failed;
     bool rescind_on_loss;
+    /*
+     * Transaction ids of guest packets sent on that want a completion the
+     * backend has not sent yet. A guest waits for each with no timeout, so a
+     * lost backend's are completed here, empty, which the guest takes as a
+     * failed request, before the channel is withdrawn.
+     */
+    GHashTable *unanswered;
 };
 
 static void gpupv_send_frame(GpupvChannel *s, uint16_t type, uint16_t flags,
@@ -175,6 +182,9 @@ static void gpupv_forward(GpupvChannel *s, VMBusChanReq *req)
         flags |= GPUPV_FRAME_HAS_RANGES;
     }
 
+    if (req->need_comp && !s->backend_lost) {
+        g_hash_table_add(s->unanswered, g_memdup2(&req->transaction_id, sizeof(uint64_t)));
+    }
     gpupv_send_frame(s, req->pkt_type, flags, req->transaction_id,
                      ranges, rlen, req->msg, req->msglen);
 }
@@ -292,6 +302,9 @@ static void gpupv_chr_read(void *opaque, const uint8_t *buf, int size)
         o->type = le16_to_cpu(f.type);
         o->need_comp = le16_to_cpu(f.flags) & GPUPV_FRAME_NEED_COMP;
         o->tid = le64_to_cpu(f.tid);
+        if (o->type == VMBUS_PACKET_COMP) {
+            g_hash_table_remove(s->unanswered, &o->tid);
+        }
         o->len = len;
         memcpy(o->data, s->rx->data + sizeof(f), len);
         g_queue_push_tail(&s->out, o);
@@ -306,6 +319,7 @@ static void gpupv_drop_pending(GpupvChannel *s)
 {
     GpupvOut *o;
 
+    g_hash_table_remove_all(s->unanswered);
     while ((o = g_queue_pop_head(&s->out))) {
         g_free(o);
     }
@@ -327,6 +341,29 @@ static void gpupv_close_channel(VMBusChannel *chan)
     gpupv_send_frame(s, GPUPV_EVT_CLOSE, 0, 0, NULL, 0, NULL, 0);
 }
 
+/* Queue an empty completion for every request the lost backend never answered. */
+static void gpupv_complete_unanswered(GpupvChannel *s)
+{
+    GHashTableIter it;
+    gpointer key;
+    guint n = g_hash_table_size(s->unanswered);
+
+    g_hash_table_iter_init(&it, s->unanswered);
+    while (g_hash_table_iter_next(&it, &key, NULL)) {
+        GpupvOut *o = g_malloc0(sizeof(*o));
+
+        o->type = VMBUS_PACKET_COMP;
+        o->tid = *(uint64_t *)key;
+        g_queue_push_tail(&s->out, o);
+    }
+    g_hash_table_remove_all(s->unanswered);
+    if (n) {
+        warn_report("%s: completing %u requests the backend never answered",
+                    object_get_typename(OBJECT(s)), n);
+    }
+    gpupv_flush(s);
+}
+
 static void gpupv_chr_event(void *opaque, QEMUChrEvent event)
 {
     GpupvChannel *s = opaque;
@@ -339,8 +376,8 @@ static void gpupv_chr_event(void *opaque, QEMUChrEvent event)
             return;
         }
         s->backend_lost = true;
-        gpupv_drop_pending(s);
         g_byte_array_set_size(s->rx, 0);
+        gpupv_complete_unanswered(s);
         if (s->arena_fd >= 0) {
             close(s->arena_fd);
             s->arena_fd = -1;
@@ -377,6 +414,7 @@ static void gpupv_vmdev_realize(VMBusDevice *vdev, Error **errp)
         return;
     }
     s->rx = g_byte_array_new();
+    s->unanswered = g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, NULL);
     s->arena_fd = -1;
     g_queue_init(&s->out);
     qemu_chr_fe_set_handlers(&s->chr, gpupv_chr_can_read, gpupv_chr_read,
@@ -396,6 +434,7 @@ static void gpupv_vmdev_unrealize(VMBusDevice *vdev)
     gpupv_drop_pending(s);
     gpupv_drop_arena(s);
     g_byte_array_free(s->rx, true);
+    g_hash_table_destroy(s->unanswered);
     qemu_chr_fe_deinit(&s->chr, false);
 }
 
